# Phase 1 mockup: no secrets are needed. Copy to .env.local if you want to override.

# Where DataRepository gets its data. "mock" = sample data + browser localStorage.
# "supabase" is reserved for Phase 2 and is not implemented yet.
NEXT_PUBLIC_DATA_SOURCE=mock

# Public site URL, used for canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sir-games-a-lot.vercel.app

# Keep "false" while the site shows sample data, so search engines never index fake stock.
# Flip to "true" in the full build once real data is live.
NEXT_PUBLIC_ALLOW_INDEXING=false
